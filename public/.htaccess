# =====================================================================
# .htaccess  -  /public/
# Configuration du dossier accessible depuis le navigateur.
# =====================================================================

# Désactiver le listage des dossiers
Options -Indexes

# UTF-8 par défaut
AddDefaultCharset UTF-8

# Page d'accueil par défaut
DirectoryIndex index.php index.html

# Page 404 personnalisée
ErrorDocument 404 /pdvweb/public/404.php


# ---------------------------------------------------------------------
# Sécurité - en-têtes HTTP
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
    # Empêcher le sniffing MIME (anti XSS)
    Header set X-Content-Type-Options "nosniff"

    # Bloquer l'affichage du site dans un <iframe> tiers (anti-clickjacking)
    Header set X-Frame-Options "SAMEORIGIN"

    # Politique de référent : ne pas envoyer l'URL en clair vers les sites externes
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
