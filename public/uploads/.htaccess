# =====================================================================
# .htaccess  -  /public/uploads/
# Bloque l'exécution de tout script dans ce dossier.
# Protection critique : si un attaquant uploadait un .php déguisé en .jpg,
# il ne pourrait pas l'exécuter en y accédant directement.
# =====================================================================

# Désactiver l'exécution de scripts
<FilesMatch "\.(php|phtml|php3|php4|php5|phar|pl|py|jsp|asp|sh|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Désactiver le traitement PHP même si le serveur tente
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Désactiver le listage
Options -Indexes
