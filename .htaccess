# =====================================================================
# .htaccess RACINE DU PROJET
# ---------------------------------------------------------------------
# On utilise une approche pragmatique :
#  - Ce .htaccess racine redirige automatiquement /pdvweb/ vers /pdvweb/public/
#  - La protection des dossiers sensibles est gérée par un .htaccess
#    DANS chacun d'eux (classes/, config/, includes/, views/, docs/)
#  - Cela évite les conflits "deny global + allow spécifique" qui
#    posent problème sur certaines configurations Apache (XAMPP inclus).
# =====================================================================

# Désactiver le listage des dossiers
Options -Indexes

# Redirection automatique : si on accède à /pdvweb/, on est envoyé vers /pdvweb/public/
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si l'URL ne commence pas déjà par "public/", on y redirige
    RewriteCond %{REQUEST_URI} !^/pdvweb/public/
    RewriteCond %{REQUEST_URI} ^/pdvweb/?$

    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
