# Dossier sql/ :
#  - Les scripts .sql ne doivent JAMAIS être téléchargeables (risque d'exposition
#    du schéma BDD et des données de test)
#  - Le script generer_hashes.php a besoin d'être accessible une fois pour
#    initialiser les hashes des comptes de test. À supprimer après usage.

# Bloquer le téléchargement des fichiers .sql
<FilesMatch "\.(sql|sql\.bak|sql\.gz)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Désactiver le listage du dossier
Options -Indexes
